# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_content_db
DATABASE_DIRECT_URL=postgresql://postgres:password@localhost:5432/ai_content_db

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# NextAuth
NEXTAUTH_SECRET=your-secret-key-here-change-in-production
NEXTAUTH_URL=http://localhost:3001

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=ai-content-assets

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_R2_BUCKET=ai-content

# Stripe (Payment)
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Stripe Price IDs (Create in Stripe Dashboard)
STRIPE_STARTER_PRICE_ID=price_xxx_starter_29
STRIPE_PRO_PRICE_ID=price_xxx_pro_99
STRIPE_ENTERPRISE_PRICE_ID=price_xxx_enterprise_299

# SendGrid (Email)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourapp.com

# App URLs
NEXT_PUBLIC_CONTENTS_STUDIO_URL=http://localhost:3001
NEXT_PUBLIC_VIDEO_GENERATOR_URL=http://localhost:3002
NEXT_PUBLIC_COPYWRITER_URL=http://localhost:3003
NEXT_PUBLIC_CONTENT_CURATOR_URL=http://localhost:3004
NEXT_PUBLIC_LOCALIZATION_HUB_URL=http://localhost:3005

# API Gateway
API_GATEWAY_URL=http://localhost:8000

# Optional: Additional AI Services
OPENAI_API_KEY=sk-your-openai-key
ELEVENLABS_API_KEY=your-elevenlabs-key
STABILITY_AI_KEY=your-stability-ai-key
HEYGEN_API_KEY=your-heygen-key

# Feature Flags
ENABLE_VIDEO_GENERATION=true
ENABLE_IMAGE_GENERATION=true
ENABLE_AUDIO_GENERATION=true

# Environment
NODE_ENV=development
